{
  "name": "mdstyled",
  "displayName": "MdStyled",
  "description": "Edit Markdown visually in a styled live preview: click to edit, table and card designers, six themes, and HTML/PDF export. Your .md stays clean.",
  "version": "1.0.1",
  "publisher": "OAS",
  "author": "Osama Abu-Sitta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OsamaAbuSitta/MDStyled.git"
  },
  "homepage": "https://github.com/OsamaAbuSitta/MDStyled#readme",
  "icon": "icons/icon.png",
  "categories": [
    "Other",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "wysiwyg",
    "visual editor",
    "markdown preview",
    "live preview",
    "table editor",
    "markdown table",
    "cards",
    "checklist",
    "themes",
    "css",
    "documentation",
    "export pdf",
    "export html",
    "mermaid"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MdStyled",
      "properties": {
        "mdstyled.defaultTemplate": {
          "type": "string",
          "enum": [
            "",
            "none",
            "editable-light",
            "editable-dark",
            "interactive-light",
            "interactive-dark",
            "default-light",
            "default-dark"
          ],
          "enumDescriptions": [
            "Not chosen yet - MdStyled asks once on the first preview of an unstyled file",
            "No default template - preview unstyled Markdown",
            "Interactive light theme with in-preview Markdown editing",
            "Interactive dark theme with in-preview Markdown editing",
            "Light theme with interactive tables",
            "Dark theme with interactive tables",
            "Light documentation theme",
            "Dark documentation theme"
          ],
          "default": "",
          "markdownDescription": "Template used in the preview when a Markdown file declares no `@style` / `@script` of its own. Applied straight from the extension - nothing is written to the Markdown file or the workspace. Leave empty to be asked once on the first preview.",
          "scope": "window"
        },
        "mdstyled.editing.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let templates edit the Markdown file from inside the preview. Turn this off to make previews read-only - the editing templates keep their styling but their editor is not offered."
        },
        "mdstyled.extensions.enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mermaid",
              "copy-code",
              "highlight"
            ]
          },
          "default": [
            "mermaid",
            "copy-code",
            "highlight"
          ],
          "markdownDescription": "Built-in extensions to enable. Extensions add diagram rendering, copy buttons, and code styling."
        }
      }
    },
    "commands": [
      {
        "command": "mdstyled.openWith",
        "title": "Open with MdStyled",
        "icon": {
          "light": "icons/mdstyled-dark.svg",
          "dark": "icons/mdstyled-light.svg"
        }
      },
      {
        "command": "mdstyled.openPreview",
        "title": "MdStyled: Open Preview",
        "icon": {
          "light": "icons/mdstyled-dark.svg",
          "dark": "icons/mdstyled-light.svg"
        }
      },
      {
        "command": "mdstyled.openPreviewToSide",
        "title": "MdStyled: Open Preview to Side"
      },
      {
        "command": "mdstyled.export",
        "title": "MdStyled: Export to..."
      },
      {
        "command": "mdstyled.setDefaultTemplate",
        "title": "MdStyled: Set Default Template"
      },
      {
        "command": "mdstyled.applyTemplate",
        "title": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.edit",
        "title": "MdStyled Edit"
      },
      {
        "command": "mdstyled.applyTemplate.editable-light",
        "title": "Editable Light",
        "category": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.applyTemplate.editable-dark",
        "title": "Editable Dark",
        "category": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.applyTemplate.interactive-light",
        "title": "Interactive Light",
        "category": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.applyTemplate.interactive-dark",
        "title": "Interactive Dark",
        "category": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.applyTemplate.default-light",
        "title": "Default Light",
        "category": "MdStyled: Apply Template"
      },
      {
        "command": "mdstyled.applyTemplate.default-dark",
        "title": "Default Dark",
        "category": "MdStyled: Apply Template"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdstyled.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdstyled.openWith",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_mdstyled@1"
        },
        {
          "command": "mdstyled.openPreview",
          "when": "resourceLangId == markdown",
          "group": "1_mdstyled@2"
        },
        {
          "command": "mdstyled.applyTemplate",
          "when": "resourceLangId == markdown",
          "group": "1_mdstyled@3"
        },
        {
          "command": "mdstyled.edit",
          "when": "resourceLangId == markdown",
          "group": "1_mdstyled@4"
        },
        {
          "submenu": "mdstyled.templates",
          "when": "resourceLangId == markdown",
          "group": "1_mdstyled@5"
        },
        {
          "command": "mdstyled.export",
          "when": "resourceLangId == markdown",
          "group": "1_mdstyled@6"
        }
      ],
      "explorer/context": [
        {
          "command": "mdstyled.openWith",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "mdstyled.edit",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_mdstyled@1"
        },
        {
          "submenu": "mdstyled.templates",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_mdstyled@2"
        },
        {
          "command": "mdstyled.export",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_mdstyled@3"
        }
      ],
      "editor/context": [
        {
          "command": "mdstyled.openWith",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "mdstyled.edit",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        },
        {
          "submenu": "mdstyled.templates",
          "when": "resourceLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "mdstyled.export",
          "when": "resourceLangId == markdown",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "mdstyled.openWith",
          "when": "false"
        }
      ],
      "mdstyled.templates": [
        {
          "command": "mdstyled.applyTemplate.editable-light",
          "group": "1_editable@1"
        },
        {
          "command": "mdstyled.applyTemplate.editable-dark",
          "group": "1_editable@2"
        },
        {
          "command": "mdstyled.applyTemplate.interactive-light",
          "group": "2_interactive@3"
        },
        {
          "command": "mdstyled.applyTemplate.interactive-dark",
          "group": "2_interactive@4"
        },
        {
          "command": "mdstyled.applyTemplate.default-light",
          "group": "3_default@5"
        },
        {
          "command": "mdstyled.applyTemplate.default-dark",
          "group": "3_default@6"
        }
      ]
    },
    "submenus": [
      {
        "id": "mdstyled.templates",
        "label": "MdStyled Templates"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node ./test/run.js",
    "test:pw": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=e2e --headed",
    "test:report": "playwright show-report",
    "test:all": "playwright test; playwright show-report",
    "build:templates": "node ./scripts/build-editable-templates.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.41",
    "@types/sanitize-html": "^2.16.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.15.0",
    "sanitize-html": "^2.12.0"
  }
}
